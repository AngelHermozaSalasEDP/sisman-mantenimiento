@page "/ot/{id:int}"
@model Sisman.Mantenimiento.Web.Pages.Ot.DetalleModel
@{
    var ot = Model.Ot;
    ViewData["Title"] = ot is null ? "Orden de trabajo" : $"OT {ot.Numero}";
}

<p><a href="/ot">‹ Volver a la lista</a></p>

@if (Model.ErrorCarga is not null)
{
    <div class="aviso error" role="alert">@Model.ErrorCarga</div>
}
else if (ot is not null)
{
    <div class="titulo">
        <h1>OT @ot.Numero</h1>
        <span class="etiqueta e@(ot.Estado)">@Textos.Estado(ot.Estado)</span>
    </div>

    <dl class="ficha">
        <dt>Descripción</dt><dd>@ot.Descripcion</dd>
        <dt>Máquina</dt><dd>@Model.Maquina</dd>
        <dt>Tipo y prioridad</dt><dd>@ot.Tipo · @ot.Prioridad</dd>
        <dt>Fecha objetivo</dt><dd>@Textos.Fecha(ot.FechaObjetivo)</dd>
        <dt>Mantenimiento preventivo</dt><dd><a href="/mp/@ot.MantenimientoPreventivoId">Ver el MP de origen</a></dd>
        <dt>Creada</dt><dd>@ot.CreadoPor · @Textos.Momento(ot.CreadoEn)</dd>
        <dt>Último cambio</dt><dd>@(ot.ModificadoPor ?? "—") · @Textos.Momento(ot.ModificadoEn)</dd>
    </dl>

    @if (Model.EsPlanificador)
    {
        <h2>Cambiar estado</h2>
        @if (ot.TransicionesPermitidas.Count == 0)
        {
            <p class="nota">Desde «@Textos.Estado(ot.Estado)» no hay más cambios de estado.</p>
        }
        else
        {
            <div class="acciones">
                @foreach (var e in ot.TransicionesPermitidas)
                {
                    <form method="post" asp-page-handler="Estado" asp-route-id="@ot.Id">
                        <input type="hidden" name="estado" value="@e" />
                        <button type="submit" class="boton">Pasar a «@Textos.Estado(e)»</button>
                    </form>
                }
            </div>
        }
    }

    <h2>Historial de estados</h2>
    <table>
        <thead><tr><th>Fecha</th><th>De</th><th>A</th><th>Usuario</th></tr></thead>
        <tbody>
            @foreach (var h in ot.Historial)
            {
                <tr>
                    <td>@Textos.Momento(h.Fecha)</td>
                    <td>@Textos.Estado(h.EstadoAnterior)</td>
                    <td>@Textos.Estado(h.EstadoNuevo)</td>
                    <td>@h.Usuario</td>
                </tr>
            }
            @if (ot.Historial.Count == 0)
            {
                <tr><td colspan="4" class="vacio">Sin cambios de estado desde que se generó.</td></tr>
            }
        </tbody>
    </table>
}
