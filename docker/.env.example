# Copie este archivo a .env y reemplace los valores. .env no se versiona.
SQL_SA_PASSWORD=<clave de SQL Server: 8+ caracteres con mayúscula, minúscula, número y símbolo>
JWT_CLAVE=<32 caracteres o más, aleatorios>
CLAVE_PLANIFICADOR=<clave de prueba del usuario planificador>
CLAVE_ESPECIALISTA=<clave de prueba del usuario especialista>
